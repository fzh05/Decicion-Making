o_crs(epsg=3857)\n","gdf_grid_boxes_3857 = gdf_grid_boxes.to_crs(epsg=3857)\n","\n","# 4. Plotting\n","fig, ax = plt.subplots(figsize=(12, 9), dpi=300)\n","\n","# Plot Kotak Grid NASA POWER (Pakai warna kuning/putih tebal agar mencolok di atas satelit)\n","gdf_grid_boxes_3857.plot(\n","    ax=ax,\n","    facecolor=\"none\",\n","    edgecolor=\"#ffff00\",\n","    linewidth=2,\n","    linestyle=\"--\",\n","    zorder=3,\n",")\n","\n","# Plot Titik & Label\n","for _, row in gdf_points_3857.iterrows():\n","    # Ambil koordinat X dan Y dalam satuan meter\n","    x, y = row.geometry.x, row.geometry.y\n","\n","    ax.scatter(\n","        x,\n","        y,\n","        color=row[\"Color\"],\n","        s=250,\n","        zorder=5,\n","        edgecolor=\"white\",\n","        linewidth=2,\n","    )\n","\n","    ax.annotate(\n","        f\"{row['Zona']}\\n({row['Lat']}°, {row['Lon']}°)\",\n","        xy=(x, y),\n","        xytext=(x + 4000, y + 4000),  # Offset label dalam meter\n","        fontsize=9.5,\n","        fontweight=\"bold\",\n","        bbox=dict(\n","            boxstyle=\"round,pad=0.35\",\n","            facecolor=\"white\",\n","            edgecolor=row[\"Color\"],\n","            linewidth=2,\n","            alpha=0.9,\n","        ),\n","        arrowprops=dict(\n","            arrowstyle=\"->\",\n","            color=\"white\",\n","            linewidth=2,\n","            connectionstyle=\"arc3,rad=0.1\",\n","        ),\n","        zorder=6,\n","    )\n","\n","# 5. TAMBAHKAN BASEMAP SATELIT / PETA ASLI\n","# Pilihan A: Satelit Esri (Kelihatan tutupan lahan, waduk Batutegi, & aliran sungai asli)\n","cx.add_basemap(ax, source=cx.providers.Esri.WorldImagery, zorder=1)\n","\n","# Pilihan B: Peta Topografi (Uncomment jika ingin melihat alur sungai berupa garis)\n","# cx.add_basemap(ax, source=cx.providers.OpenTopoMap, zorder=1)\n","\n","# Rapikan Tampilan\n","ax.set_title(\n","    \"Peta Lokasi Titik Grid NASA POWER pada Citra Satelit DAS Way Sekampung\",\n","    fontweight=\"bold\",\n","    fontsize=12,\n","    pad=12,\n",")\n","ax.set_axis_off()  # Sembunyikan aksis koordinat meter agar lebih bersih\n","\n","plt.tight_layout()\n","plt.savefig(\"peta_satelit_das_sekampung.png\", bbox_inches=\"tight\", dpi=300)\n","plt.show()"]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMbCTPBZAyRPJNqSij+NiWU"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}